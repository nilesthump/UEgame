* text=auto eol=lf
# Keep spec text byte-stable across platforms; no source-hash gate depends on it.
spec/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.uasset binary
*.umap binary
*.wav binary
*.mp3 binary
*.ogg binary
*.flac binary
